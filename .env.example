# Copy to `.env.local` and fill in what the environment actually needs.
# A key left blank counts as unset — the documented default is used.
# Every value here is optional: with none of them set the site builds and runs,
# the map draws its schematic placeholder, and WhatsApp replies are skipped.
#
# NEXT_PUBLIC_* is inlined into the browser bundle at build time — never put a
# secret behind that prefix.

# --- Site ---------------------------------------------------------------
# Canonical origin for metadata, JSON-LD, the sitemap and the OG card.
# Unset on Vercel, the deployment's own domain is used, so canonicals always
# point somewhere that resolves. Set this the day the real domain goes live.
# Fallback when neither is present: https://www.interione.in
NEXT_PUBLIC_SITE_URL=

# --- Search Console -----------------------------------------------------
# The `content` value from Search Console's HTML-tag verification method
# (just the token, not the whole <meta> tag). Unset omits the tag.
GOOGLE_SITE_VERIFICATION=

# --- Studio map ---------------------------------------------------------
# Mapbox is tried first, Google second, placeholder if neither is present.
# See src/lib/map.ts.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Override to a Mapbox Studio style of our own.
# Default: mapbox://styles/mapbox/light-v11
NEXT_PUBLIC_MAPBOX_STYLE=

# --- WhatsApp Cloud API (server only) -----------------------------------
# The first two together switch replies on; without them the webhook accepts
# deliveries and does nothing. See src/lib/whatsapp-cloud.ts.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Echoed back to Meta during webhook verification — any string you choose.
WHATSAPP_VERIFY_TOKEN=
# App secret, used to prove a delivery really came from Meta.
WHATSAPP_APP_SECRET=
# Graph API version. Default: v23.0
WHATSAPP_GRAPH_VERSION=

# --- Leads --------------------------------------------------------------
# Where an inbound WhatsApp lead is POSTed as JSON (CRM, Zapier, Sheets).
# Unset means leads are only written to the server log.
LEAD_WEBHOOK_URL=
